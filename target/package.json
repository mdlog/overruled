{
  "name": "trailhead-supply",
  "version": "1.0.0",
  "private": true,
  "description": "Trailhead Supply: a small outdoor-gear store with a policy-bound AI support assistant (Express + SQLite + Ollama).",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0"
  }
}
